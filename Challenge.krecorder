<thead>
<tr><td rowspan="1" colspan="3" data-tags="">LoginUser</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://ping-mottu.azurewebsites.net/login<datalist><option>https://ping-mottu.azurewebsites.net/login</option></datalist></td><td></td></tr>
<tr><td>click</td><td>name=username<datalist><option>name=username</option><option>xpath=//input[@name='username']</option><option>xpath=//input</option><option>css=input[name="username"]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>name=username<datalist><option>name=username</option><option>xpath=//input[@name='username']</option><option>xpath=//input</option><option>css=input[name="username"]</option></datalist></td><td>user</td></tr>
<tr><td>click</td><td>name=password<datalist><option>name=password</option><option>xpath=//input[@name='password']</option><option>xpath=//input[2]</option><option>css=input[name="password"]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>name=password<datalist><option>name=password</option><option>xpath=//input[@name='password']</option><option>xpath=//input[2]</option><option>css=input[name="password"]</option></datalist></td><td>user</td></tr>
<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Login de Funcionário'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Katalon Recorder is recording ...'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Stop'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Entrar']/parent::*</option><option>xpath=//button</option><option>css=button[type="submit"]</option></datalist></td><td></td></tr>
<tr><td>open</td><td>https://ping-mottu.azurewebsites.net/<datalist><option>https://ping-mottu.azurewebsites.net/</option></datalist></td><td></td></tr>
</tbody></table>
